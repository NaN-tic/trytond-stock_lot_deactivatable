<tryton>
    <data>
        <record model="ir.ui.view" id="stock_configuration_view_form">
            <field name="model">stock.configuration</field>
            <field name="inherit" ref="stock.stock_configuration_view_form"/>
            <field name="name">configuration_form</field>
        </record>

        <!-- cron task -->
        <record model="ir.cron" id="cron_deactivate_lots_without_stock">
            <field name="method">stock.lot|deactivate_lots_without_stock</field>
            <field name="interval_number" eval="1"/>
            <field name="interval_type">days</field>
        </record>
    </data>
</tryton>
